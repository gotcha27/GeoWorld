{
   "name": "geoworld",
   "version": "0.0.1",
   "description": "Awesome project developed with TypeORM.",
   "type": "commonjs",
   "devDependencies": {
      "@types/bcrypt": "^6.0.0",
      "@types/cors": "^2.8.19",
      "@types/express": "^5.0.6",
      "@types/jsonwebtoken": "^9.0.10",
      "@types/node": "^22.20.4",
      "nodemon": "^3.1.14",
      "ts-node": "^10.9.2",
      "typescript": "^5.9.3"
   },
   "dependencies": {
      "bcrypt": "^6.0.0",
      "cors": "^2.8.6",
      "dotenv": "^18.0.4",
      "express": "^5.2.1",
      "i18n-iso-countries": "^7.14.0",
      "jsonwebtoken": "^9.0.3",
      "mysql2": "^3.24.5",
      "pg": "^8.23.0",
      "reflect-metadata": "^0.2.2",
      "typeorm": "^0.3.31"
   },
   "scripts": {
      "start": "ts-node src/index.ts",
      "typeorm": "typeorm-ts-node-commonjs",
      "dev": "nodemon src/index.ts",
      "typeorm:revert": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert",
      "typeorm:migrate": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate -n",
      "typeorm:run": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run"
   }
}
